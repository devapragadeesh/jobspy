# Supabase (Project Settings → API). The secret key is server-only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Gemini free tier (https://aistudio.google.com/apikey). Models are rotated automatically.
GEMINI_API_KEY=

# Web search for company and pay research: a local SearXNG (see README). Leave empty to skip.
SEARXNG_URL=http://localhost:8888

# Local runs only: use Ollama for everything (otherwise it is only the fallback when Gemini is exhausted)
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:7b

# Gmail sender (scanner only): the account that sends, and its 16-character app password
GMAIL_USER=
GMAIL_APP_PASSWORD=

# UI (Vercel only)
APP_PASSWORD=
SESSION_SECRET=
# "Scan now" button: fine-grained token with Actions read/write on the repo
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=devapragadeesh/jobspy
